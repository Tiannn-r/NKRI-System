# Databases
*.db
*.sqlite
*.sqlite3

# Backups and archives
*.zip
*.tar.gz
*.bak
*.bak*
*_bak
*.backup*
*-shm
*-wal
node_modules/

# Laravel vendor and node_modules
HASIL REFACTOR/vendor/
HASIL REFACTOR/node_modules/
HASIL REFACTOR/.env
HASIL REFACTOR/storage/logs/*.log
HASIL REFACTOR/storage/framework/cache/*
HASIL REFACTOR/storage/framework/sessions/*
HASIL REFACTOR/storage/framework/views/*
HASIL REFACTOR/bootstrap/cache/*.php
!HASIL REFACTOR/bootstrap/cache/.gitignore

# Scratch and temp files
scratch/
__pycache__/
*.pyc
.DS_Store
Thumbs.db
