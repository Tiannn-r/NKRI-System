                    SET assy_status_history = CASE
                        WHEN lifecycle_path LIKE '%REWORK%' THEN 'Hold -> Rework -> Good'
                        WHEN lifecycle_path LIKE '%HOLD%' AND (status = 'Good' OR verified_status = 'APPROVED') THEN 'Hold -> Good'
                        ELSE 'Good'
                    END
                    WHERE assy_status_history IS NULL AND (assy_doc_number IS NOT NULL OR assy_test_checklist IS NOT NULL);
                """)
                cur.execute("""
                    UPDATE assemblies
                    SET qc_status_history = CASE
                        WHEN lifecycle_path LIKE '%REWORK%' THEN 'Hold QC -> Rework QC -> Good QC'
                        WHEN lifecycle_path LIKE '%HOLD%' AND (qc_status = 'GOOD' OR verified_status = 'APPROVED_QC') THEN 'Hold QC -> Good QC'
                        ELSE 'Good QC'
                    END
                    WHERE qc_status_history IS NULL AND qc_doc_number IS NOT NULL;
                """)
                conn.commit()
    except Exception as e:
        print(f"Error initializing schema: {e}", flush=True)

