def send_json(handler, data, status=200):
    try:
        body = json.dumps(data, default=str).encode("utf-8")
        handler.send_response(status)
        handler.send_header("Content-Type", "application/json; charset=utf-8")
        handler.send_header("Access-Control-Allow-Origin", "*")
        handler.send_header("Access-Control-Allow-Headers", "*")
        handler.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        handler.send_header("Content-Length", str(len(body)))
        handler.end_headers()
        handler.wfile.write(body)
        handler.wfile.flush()
    except (ConnectionResetError, BrokenPipeError, ConnectionAbortedError):
        pass
    except Exception as ex:
        if "10053" not in str(ex) and "10054" not in str(ex):
            print(f"Error in send_json: {ex}", flush=True)

def check_auth(handler):
    auth = handler.headers.get("Authorization")
    if not auth or not auth.startswith("Bearer "):
        return None
    token = auth.split(" ")[1]
    try:
        with get_conn() as conn:
            with conn.cursor() as cur:
                # Check active session within 30 minutes activity window
                cur.execute("""
                    SELECT user_id as id, username, role, full_name, nik, last_activity 
                    FROM user_sessions 
                    WHERE token = %s AND (last_activity IS NULL OR last_activity >= NOW() - INTERVAL '30 minutes')
                """, (token,))
                sess = cur.fetchone()
                if sess:
                    # Refresh last activity timestamp
                    cur.execute("UPDATE user_sessions SET last_activity = NOW() WHERE token = %s", (token,))
                    conn.commit()
                    u_data = dict(sess)
                    SESSIONS[token] = u_data
                    return u_data
                else:
                    SESSIONS.pop(token, None)
                    cur.execute("DELETE FROM user_sessions WHERE token = %s OR (last_activity IS NOT NULL AND last_activity < NOW() - INTERVAL '30 minutes')", (token,))
                    conn.commit()
    except Exception as ex:
        print(f"Error in check_auth: {ex}", flush=True)
    return None

def normalize_sn(part_type, sn_raw):
    s = (sn_raw or "").strip().upper()
    if part_type == '1':
        # Accepts '1'..'999' -> '001'..'999' (3 digits)
        # Accepts '1000'..'6000' -> '1000'..'6000' (4 digits)
        if s.isdigit():
            val = int(s)
            if 1 <= val <= 999:
                return f"{val:03d}"
            elif 1000 <= val <= 6000:
                return f"{val:04d}"
        return s
    elif part_type == '12':
        # Accepts '6001'..'6500' and '7001'..'7500' (4 digits)
        clean = s.replace(".", "").replace(",", "").replace(" ", "")
        if clean.isdigit():
            val = int(clean)
            if (6001 <= val <= 6500) or (7001 <= val <= 7500):
                return str(val)
        return clean
    elif part_type == '15':
        return s.replace(" ", "")
    return s

def get_tray_doc_number(tray_code, stage):
    prefix = "Assy/QC/" if stage == "ASSY" else "WH/QC/"
    if not tray_code:
        return f"{prefix}000001"
    code_str = str(tray_code).strip()
    if "/" in code_str:
        suffix = code_str.split("/")[-1]
        return f"{prefix}{suffix}"
    return f"{prefix}{code_str}"

def get_next_doc_number(cur, stage):
    prefix = "Assy/QC/" if stage == "ASSY" else "WH/QC/"
    cur.execute("SELECT doc_number FROM assembly_tests WHERE stage = %s AND doc_number LIKE %s ORDER BY id DESC LIMIT 1", (stage, prefix + '%'))
    row = cur.fetchone()
    if row and row.get('doc_number'):
        try:
            val = int(row['doc_number'].split('/')[-1]) + 1
        except Exception:
            val = 1
    else:
        col = 'assy_doc_number' if stage == 'ASSY' else 'qc_doc_number'
        cur.execute(f"SELECT {col} FROM assemblies WHERE {col} LIKE %s ORDER BY id DESC LIMIT 1", (prefix + '%',))
        row2 = cur.fetchone()
        if row2 and row2.get(col):
            try:
                val = int(row2[col].split('/')[-1]) + 1
            except Exception:
                val = 1
        else:
            val = 1
    return f"{prefix}{str(val).zfill(6)}"

